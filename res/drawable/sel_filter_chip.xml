<?xml version="1.0" encoding="utf-8"?>
<!-- 豆瓣筛选 chip：焦点态明显（黄描边 + 提亮），TV 遥控下要看得出焦点 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A3220" />
            <stroke android:width="3dp" android:color="#FFD54F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#5A2A28" />
            <stroke android:width="2dp" android:color="#E53935" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A4258" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#242830" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
